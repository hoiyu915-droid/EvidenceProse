{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/rule.schema.json",
  "title": "EvidenceProse rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "name",
    "category",
    "statement",
    "status",
    "applies_when",
    "does_not_apply_when",
    "support",
    "counterexamples",
    "confidence",
    "validator_potential",
    "last_updated"
  ],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "category": {
      "enum": ["architecture", "claim_transform", "calibration", "provenance", "mechanism", "limitations", "decision_positioning", "evidence_grade", "quantitative_semantics"]
    },
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["hypothesis", "candidate", "conditional", "stable", "contradicted", "rejected"]},
    "applies_when": {"type": "array", "items": {"type": "string"}},
    "does_not_apply_when": {"type": "array", "items": {"type": "string"}},
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "observation_ids"],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
          "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^O[0-9]{3}$"}}
        }
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_id", "description"],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
          "description": {"type": "string"}
        }
      }
    },
    "confidence": {"enum": ["low", "moderate", "high"]},
    "validator_potential": {"enum": ["none", "manual", "partial", "automatable"]},
    "last_updated": {"type": "string", "format": "date"}
  }
}
