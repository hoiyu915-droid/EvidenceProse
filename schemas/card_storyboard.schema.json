{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/card_storyboard.schema.json",
  "title": "EvidenceProse companion-card audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "audit_policy", "canonical_queue", "rejected_queue", "cards", "summary"],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
    "audit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_track", "strict_render_track", "global_constraints_checked"],
      "properties": {
        "semantic_track": {"type": "string", "minLength": 1},
        "strict_render_track": {"type": "string", "minLength": 1},
        "global_constraints_checked": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "canonical_queue": {"$ref": "#/$defs/canonicalQueue"},
    "rejected_queue": {"$ref": "#/$defs/rejectedQueue"},
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/card"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cards", "semantic_passes", "semantic_failures", "strict_render_passes", "strict_render_failures", "interpretation"],
      "properties": {
        "cards": {"type": "integer", "minimum": 1},
        "semantic_passes": {"type": "integer", "minimum": 0},
        "semantic_failures": {"type": "integer", "minimum": 0},
        "strict_render_passes": {"type": "integer", "minimum": 0},
        "strict_render_failures": {"type": "integer", "minimum": 0},
        "targeted_correction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2}$"}},
        "interpretation": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "canonicalQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "plan_id", "binding_basis"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan_id": {"type": "string", "minLength": 1},
        "binding_basis": {"type": "string", "minLength": 1}
      }
    },
    "rejectedQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "reason"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "title", "visible_text", "allowed_visible_numbers", "main_visual_scene", "image_filename", "image_sha256", "semantic_audit", "strict_render_audit"],
      "properties": {
        "card_id": {"type": "string", "pattern": "^C[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "visible_text": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_visible_numbers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "main_visual_scene": {"type": "string", "minLength": 1},
        "image_filename": {"type": "string", "minLength": 1},
        "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "semantic_audit": {"enum": ["pass", "fail"]},
        "semantic_violations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "strict_render_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "violations"],
          "properties": {
            "status": {"enum": ["pass", "fail"]},
            "violations": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "targeted_audit": {"type": "string", "minLength": 1},
        "required_correction": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
