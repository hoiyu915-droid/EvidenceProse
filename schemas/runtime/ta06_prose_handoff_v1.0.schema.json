{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/ta06_prose_handoff_v1.0.schema.json",
  "title": "EvidenceProse TA06 prose handoff v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "handoff_id",
    "producer",
    "consumer",
    "ta06_packet",
    "reader_context",
    "claims",
    "evidence",
    "citations",
    "terminology",
    "numeric_ledger",
    "permission"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "const": "TA06"
    },
    "consumer": {
      "const": "EvidenceProse"
    },
    "ta06_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "packet_version",
        "packet_digest",
        "status",
        "execution_profile",
        "source_count"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_version": {
          "type": "string",
          "minLength": 1
        },
        "packet_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "pass"
        },
        "execution_profile": {
          "enum": [
            "lite",
            "numeric",
            "full"
          ]
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reader_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "purpose",
        "resolution_source"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "resolution_source": {
          "enum": [
            "explicit_user",
            "ta06_input",
            "local_rendering_default"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_text",
          "label",
          "permission",
          "source_ids",
          "source_locators",
          "support_state",
          "boundary_note"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": [
              "CORE",
              "INFERENCE",
              "GAP",
              "CONFLICT"
            ]
          },
          "permission": {
            "enum": [
              "allowed",
              "conditional",
              "forbidden"
            ]
          },
          "condition_if_any": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "support_state": {
            "enum": [
              "supported",
              "mixed",
              "plausible_unverified",
              "unsupported",
              "conflicted"
            ]
          },
          "boundary_note": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim_id",
          "source_id",
          "source_locator",
          "design",
          "population",
          "uncertainty",
          "evidence_role"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "design": {
            "type": "string"
          },
          "population": {
            "type": "string"
          },
          "effect_direction": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "sign": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "type": "string"
          },
          "evidence_role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_id",
          "source_ids",
          "public_reference",
          "verification_state"
        ],
        "properties": {
          "citation_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "public_reference": {
            "type": "string",
            "minLength": 1
          },
          "verification_state": {
            "enum": [
              "externally_verified",
              "pdf_only",
              "conflict",
              "unresolved"
            ]
          }
        }
      }
    },
    "terminology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_terms",
        "forbidden_aliases",
        "required_qualifiers"
      ],
      "properties": {
        "preferred_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "numeric_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ledger_id",
          "claim_id",
          "source_id",
          "source_locator",
          "value",
          "unit",
          "surface",
          "transformation_state"
        ],
        "properties": {
          "ledger_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "sign": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "transformation_state": {
            "enum": [
              "direct",
              "derived"
            ]
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_permission",
        "released_claim_ids",
        "blocked_claim_ids",
        "forbidden_overclaims",
        "required_qualifiers"
      ],
      "properties": {
        "document_permission": {
          "enum": [
            "allowed",
            "conditional",
            "forbidden"
          ]
        },
        "released_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_overclaims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
