{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/prose_audit_sidecar_v1.1.schema.json",
  "title": "EvidenceProse prose audit sidecar v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "article_id",
    "handoff_digest",
    "reader_contract_digest",
    "article_sha256",
    "delivery_length_exception",
    "semantic_guard",
    "reader_outcomes",
    "missing_action_info",
    "lint_warnings",
    "violations",
    "targeted_repairs",
    "final_gate"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reader_contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "article_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "delivery_length_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted",
        "measured_characters",
        "ceiling",
        "reason"
      ],
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "measured_characters": {
          "type": "integer",
          "minimum": 0
        },
        "ceiling": {
          "const": 4000
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "semantic_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_loss",
        "no_add",
        "numeric_fidelity",
        "denominator_fidelity",
        "comparator_fidelity",
        "timeframe_fidelity",
        "population_scope_fidelity",
        "causal_strength_fidelity",
        "uncertainty_fidelity",
        "evidence_role_fidelity",
        "attribution_fidelity",
        "source_layer_fidelity",
        "required_qualifiers_present",
        "forbidden_overclaims_absent",
        "headline_not_stronger_than_body",
        "analogy_not_presented_as_mechanism",
        "practical_meaning_not_upgraded_to_recommendation"
      ],
      "properties": {
        "no_loss": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "no_add": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "numeric_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "denominator_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "comparator_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "timeframe_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "population_scope_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "causal_strength_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "uncertainty_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence_role_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "attribution_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "source_layer_fidelity": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "required_qualifiers_present": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "forbidden_overclaims_absent": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "headline_not_stronger_than_body": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "analogy_not_presented_as_mechanism": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "practical_meaning_not_upgraded_to_recommendation": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "reader_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant",
        "findable",
        "understandable",
        "usable"
      ],
      "properties": {
        "relevant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "findable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "understandable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "usable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "missing_action_info": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lint_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "location",
          "message"
        ],
        "properties": {
          "category": {
            "enum": [
              "long_sentence",
              "long_paragraph",
              "de_chain",
              "vague_pronoun",
              "unnecessary_code_switching",
              "passive_voice",
              "hedge_stack",
              "jargon_density"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "location",
          "description",
          "required_repair"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "hard",
              "warning"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_repair": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "targeted_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repair_id",
          "location",
          "status",
          "description"
        ],
        "properties": {
          "repair_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "applied",
              "verified"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "final_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
