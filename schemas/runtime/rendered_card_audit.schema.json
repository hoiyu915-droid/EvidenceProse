{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/rendered_card_audit.schema.json",
  "title": "EvidenceProse Rendered Card Audit result v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "created_at", "source_bindings",
    "dedup_manifest", "card_audits", "cardset_audit", "methodological_risk",
    "release_gate", "repair_tickets", "provenance"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "dedup_manifest": {
      "type": "object",
      "required": ["unique_card_count", "duplicate_count", "duplicates"],
      "properties": {
        "unique_card_count": {"type": "integer", "minimum": 1},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "array"}
      }
    },
    "card_audits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "card_id", "image_path", "image_sha256", "blind_readback",
          "expected_semantic_packet_digest", "axes", "findings",
          "historical_text_comparison", "verdict", "release_blocking",
          "failure_origin", "repair_ticket_id"
        ],
        "properties": {
          "card_id": {"type": "string", "minLength": 1},
          "image_path": {"type": "string", "minLength": 1},
          "image_sha256": {"$ref": "#/$defs/sha256"},
          "blind_readback": {
            "type": "object",
            "required": ["frozen_before_comparison", "digest", "legibility", "central_message", "apparent_evidence_strength", "apparent_causal_structure", "limitations_as_read"],
            "properties": {
              "frozen_before_comparison": {"const": true},
              "digest": {"$ref": "#/$defs/sha256"},
              "legibility": {"enum": ["complete", "partial", "insufficient"]},
              "central_message": {"type": "string"},
              "apparent_evidence_strength": {"type": "string"},
              "apparent_causal_structure": {"type": "string"},
              "limitations_as_read": {"type": "array", "items": {"type": "string"}}
            }
          },
          "expected_semantic_packet_digest": {"$ref": "#/$defs/sha256"},
          "axes": {
            "type": "object",
            "required": ["CONTENT_MEANING", "SOURCE_SURFACE", "VISUAL_SEMANTICS", "CITATION_TRACEABILITY", "ENGINEERING_CONFORMANCE"],
            "properties": {
              "CONTENT_MEANING": {"$ref": "#/$defs/semanticStatus"},
              "SOURCE_SURFACE": {"$ref": "#/$defs/semanticStatus"},
              "VISUAL_SEMANTICS": {"$ref": "#/$defs/semanticStatus"},
              "CITATION_TRACEABILITY": {"$ref": "#/$defs/semanticStatus"},
              "ENGINEERING_CONFORMANCE": {"enum": ["pass", "warning", "fail"]}
            }
          },
          "findings": {"type": "array", "items": {"type": "object"}},
          "historical_text_comparison": {"enum": ["equivalent", "wording_divergence", "not_compared"]},
          "verdict": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL_RENDER", "FAIL_SPEC", "BLOCK_UNVERIFIABLE"]},
          "release_blocking": {"type": "boolean"},
          "failure_origin": {"enum": ["FINAL_CARD_SPEC", "TRUTH_BOUNDARY", "SOURCE_BINDING", "MIXED", null]},
          "repair_ticket_id": {"type": ["string", "null"]}
        }
      }
    },
    "cardset_audit": {
      "type": "object",
      "required": ["status", "scope", "cross_card_findings", "package_coverage"],
      "properties": {
        "status": {"enum": ["PASS", "WARNING", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "scope": {"const": "cross_card_and_package_only"},
        "cross_card_findings": {"type": "array"},
        "package_coverage": {"type": "object"}
      }
    },
    "methodological_risk": {
      "type": "object",
      "required": [
        "high_stakes_cardset", "high_stakes_reasons", "generator_model_family",
        "auditor_model_family", "relationship", "correlated_error_risk",
        "material_to_run", "secondary_review_required", "secondary_review_status",
        "secondary_review_outcome", "release_effect", "materiality_reason"
      ],
      "properties": {
        "high_stakes_cardset": {"type": "boolean"},
        "high_stakes_reasons": {"type": "array", "items": {"type": "string"}},
        "generator_model_family": {"type": "string"},
        "auditor_model_family": {"type": "string"},
        "relationship": {"enum": ["different_family", "same_family", "unknown"]},
        "correlated_error_risk": {"enum": ["low", "present", "unknown"]},
        "material_to_run": {"type": "boolean"},
        "secondary_review_required": {"type": "boolean"},
        "secondary_review_status": {"enum": ["not_required", "pending", "completed", "unavailable"]},
        "secondary_review_outcome": {"enum": ["not_applicable", "agreement", "disagreement", "unavailable"]},
        "release_effect": {"enum": ["none", "warning_ceiling", "blocked_pending_secondary_review", "blocked_unresolved_disagreement"]},
        "materiality_reason": {"type": "string", "minLength": 1}
      }
    },
    "release_gate": {"type": "object"},
    "repair_tickets": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticStatus": {"enum": ["pass", "warning", "fail", "unverifiable"]}
  }
}
