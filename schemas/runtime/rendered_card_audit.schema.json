{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/rendered_card_audit.schema.json",
  "title": "EvidenceProse Rendered Card Audit result v1.0 / topology-gated method revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "method_revision",
    "run_id",
    "created_at",
    "source_bindings",
    "dedup_manifest",
    "card_audits",
    "cardset_audit",
    "methodological_risk",
    "release_gate",
    "repair_tickets",
    "human_repair_display",
    "provenance"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "method_revision": {"const": "1.1-topology-gated"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "dedup_manifest": {
      "type": "object",
      "required": ["unique_card_count", "duplicate_count", "duplicates"],
      "properties": {
        "unique_card_count": {"type": "integer", "minimum": 1},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "array"}
      }
    },
    "card_audits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cardAudit"}},
    "cardset_audit": {"type": "object"},
    "methodological_risk": {"type": "object"},
    "release_gate": {"type": "object"},
    "repair_tickets": {"type": "array", "items": {"type": "object"}},
    "human_repair_display": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/humanRepairDisplay"}]},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticStatus": {"enum": ["pass", "warning", "fail", "unverifiable"]},
    "cardAudit": {
      "type": "object",
      "required": [
        "card_id", "card_title", "image_path", "image_sha256", "blind_readback",
        "expected_semantic_packet_digest", "visual_semantic_reconciliation", "axes",
        "findings", "historical_text_comparison", "verdict", "release_blocking",
        "failure_origin", "repair_ticket_id"
      ],
      "properties": {
        "card_id": {"type": "string", "minLength": 1},
        "card_title": {"type": "string", "minLength": 1},
        "image_path": {"type": "string", "minLength": 1},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "blind_readback": {
          "type": "object",
          "required": [
            "frozen_before_comparison", "digest", "visual_graph_digest", "legibility",
            "central_message", "apparent_evidence_strength", "apparent_causal_structure",
            "limitations_as_read"
          ]
        },
        "expected_semantic_packet_digest": {"$ref": "#/$defs/sha256"},
        "visual_semantic_reconciliation": {"$ref": "#/$defs/visualReconciliation"},
        "axes": {
          "type": "object",
          "required": ["CONTENT_MEANING", "SOURCE_SURFACE", "VISUAL_SEMANTICS", "CITATION_TRACEABILITY", "ENGINEERING_CONFORMANCE"],
          "properties": {
            "CONTENT_MEANING": {"$ref": "#/$defs/semanticStatus"},
            "SOURCE_SURFACE": {"$ref": "#/$defs/semanticStatus"},
            "VISUAL_SEMANTICS": {"$ref": "#/$defs/semanticStatus"},
            "CITATION_TRACEABILITY": {"$ref": "#/$defs/semanticStatus"},
            "ENGINEERING_CONFORMANCE": {"enum": ["pass", "warning", "fail"]}
          }
        },
        "findings": {"type": "array"},
        "historical_text_comparison": {"enum": ["equivalent", "wording_divergence", "not_compared"]},
        "verdict": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL_RENDER", "FAIL_SPEC", "BLOCK_UNVERIFIABLE"]},
        "release_blocking": {"type": "boolean"},
        "failure_origin": {"enum": ["FINAL_CARD_SPEC", "TRUTH_BOUNDARY", "SOURCE_BINDING", "MIXED", null]},
        "repair_ticket_id": {"type": ["string", "null"]}
      }
    },
    "visualReconciliation": {
      "type": "object",
      "required": [
        "source_structure", "observed_graph", "observed_graph_digest", "expected_graph",
        "expected_graph_digest", "edge_checks", "expected_relation_checks", "branch_point_checks",
        "terminal_state_checks", "text_visual_consistency", "topology_completion"
      ],
      "properties": {
        "source_structure": {"type": "object"},
        "observed_graph": {"type": "object"},
        "observed_graph_digest": {"$ref": "#/$defs/sha256"},
        "expected_graph": {"type": "object"},
        "expected_graph_digest": {"$ref": "#/$defs/sha256"},
        "edge_checks": {"type": "array"},
        "expected_relation_checks": {"type": "array"},
        "branch_point_checks": {"type": "array"},
        "terminal_state_checks": {"type": "array"},
        "text_visual_consistency": {"type": "object"},
        "topology_completion": {"type": "object"}
      }
    },
    "humanRepairDisplay": {
      "type": "object",
      "required": ["surface", "single_block", "first_line", "sections", "rendered_text"],
      "properties": {
        "surface": {"const": "writing_block"},
        "single_block": {"const": true},
        "first_line": {"const": "imgedit"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["card_id", "card_title", "ticket_id", "heading", "content"],
            "properties": {
              "card_id": {"type": "string"},
              "card_title": {"type": "string"},
              "ticket_id": {"type": "string"},
              "heading": {"type": "string"},
              "content": {"type": "string", "minLength": 1}
            }
          }
        },
        "rendered_text": {"type": "string", "minLength": 1}
      }
    }
  }
}
