{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/batch_results.schema.json",
  "title": "EvidenceProse cumulative batch result index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_updated", "batch_count", "batches", "cross_batch_summary"],
  "properties": {
    "schema_version": {"type": "string"},
    "last_updated": {"type": "string", "format": "date"},
    "batch_count": {"type": "integer", "minimum": 1},
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_id", "sample_id", "topic", "source_class", "article_result", "method_result", "voice_result", "companion_audit", "induced_rule_ids", "qualified_rule_ids", "induced_voice_rule_ids", "contamination_note_ids"],
        "properties": {
          "batch_id": {"type": "string", "pattern": "^B[0-9]{3}$"},
          "sample_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
          "topic": {"type": "string", "minLength": 1},
          "source_class": {"type": "string", "minLength": 1},
          "canonical_queue_family": {"type": ["string", "null"]},
          "article_result": {"type": "string", "minLength": 1},
          "method_result": {"type": "string", "minLength": 1},
          "voice_result": {"type": "string", "minLength": 1},
          "companion_audit": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "note"],
                "properties": {
                  "status": {"type": "string", "minLength": 1},
                  "note": {"type": "string", "minLength": 1}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "cards", "content_truth_passes", "content_truth_failures", "render_fidelity_passes", "render_fidelity_failures", "engineering_conformance_is_gate", "derived_reader_outcome"],
                "properties": {
                  "status": {"type": "string", "minLength": 1},
                  "cards": {"type": "integer", "minimum": 1},
                  "content_truth_passes": {"type": "integer", "minimum": 0},
                  "content_truth_failures": {"type": "integer", "minimum": 0},
                  "render_fidelity_passes": {"type": "integer", "minimum": 0},
                  "render_fidelity_failures": {"type": "integer", "minimum": 0},
                  "engineering_conformance_is_gate": {"const": false},
                  "historical_text_equivalent": {"type": "integer", "minimum": 0},
                  "historical_text_wording_divergence": {"type": "integer", "minimum": 0},
                  "content_truth_failure_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2}$"}},
                  "render_fidelity_failure_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2}$"}},
                  "historical_text_wording_divergence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2}$"}},
                  "targeted_correction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2}$"}},
                  "content_truth_failure_note": {"type": "string", "minLength": 1},
                  "render_fidelity_failure_note": {"type": "string", "minLength": 1},
                  "historical_text_comparison_note": {"type": "string", "minLength": 1},
                  "derived_reader_outcome": {"$ref": "#/$defs/derivedReaderOutcome"}
                }
              }
            ]
          },
          "induced_rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]{3}$"}},
          "qualified_rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]{3}$"}},
          "induced_voice_rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^V[0-9]{3}$"}},
          "contamination_note_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3}$"}}
        }
      }
    },
    "cross_batch_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_layer", "voice_layer", "next_gate"],
      "properties": {
        "method_layer": {"type": "object"},
        "voice_layer": {"type": "object"},
        "next_gate": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "derivedReaderOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "central_claim", "evidence_weight", "limitations", "applicability", "misuse_boundaries", "blocking_card_ids", "interpretation"],
      "properties": {
        "status": {"enum": ["communicated", "materially_incomplete", "misleading"]},
        "central_claim": {"$ref": "#/$defs/readerDimensionOutcome"},
        "evidence_weight": {"$ref": "#/$defs/readerDimensionOutcome"},
        "limitations": {"$ref": "#/$defs/readerDimensionOutcome"},
        "applicability": {"$ref": "#/$defs/readerDimensionOutcome"},
        "misuse_boundaries": {"$ref": "#/$defs/readerDimensionOutcome"},
        "blocking_card_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C[0-9]{2}$"}
        },
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "readerDimensionOutcome": {
      "enum": ["clear", "not_clear", "distorted"]
    }
  }
}
