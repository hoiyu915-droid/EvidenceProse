{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceprose.local/schemas/sample.schema.json",
  "title": "EvidenceProse observation sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "title",
    "language",
    "article_path",
    "article_sha256",
    "source",
    "source_resolution",
    "study_profile",
    "observations",
    "contamination_notes",
    "analysis_date"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "const": "zh-Hant"},
    "article_path": {"type": "string", "pattern": "^data/samples/S[0-9]{3}/article\\.md$"},
    "article_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "doi", "verification_state"],
      "properties": {
        "citation": {"type": "string"},
        "doi": {"type": "string", "pattern": "^10\\."},
        "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "verification_state": {"enum": ["metadata_only", "abstract", "full_text", "full_text_audited"]}
      }
    },
    "source_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["searched_at", "stage", "query_keys", "searches", "resolution", "selected_pdf", "fallback"],
      "properties": {
        "searched_at": {"type": "string", "format": "date-time"},
        "stage": {"enum": ["pre_audit", "retrospective_backfill"]},
        "query_keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "doi", "filename"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "doi": {"type": "string", "pattern": "^10\\."},
            "filename": {"type": "string", "minLength": 1},
            "authors": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "year": {"type": ["integer", "null"], "minimum": 1900}
          }
        },
        "searches": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/librarySearchReceipt"},
                {
                  "type": "object",
                  "properties": {
                    "priority": {"const": 1},
                    "target_kind": {"const": "source_pdf"},
                    "strategy": {"const": "doi"}
                  }
                }
              ]
            }
          ],
          "items": {"$ref": "#/$defs/librarySearchReceipt"}
        },
        "resolution": {"enum": ["library_selected", "current_upload_fallback", "unresolved"]},
        "selected_pdf": {
          "oneOf": [
            {"$ref": "#/$defs/librarySelectedPdf"},
            {"$ref": "#/$defs/uploadSelectedPdf"},
            {"type": "null"}
          ]
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "reason"],
          "properties": {
            "used": {"type": "boolean"},
            "reason": {"type": ["string", "null"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"resolution": {"const": "library_selected"}}},
          "then": {
            "properties": {
              "selected_pdf": {"$ref": "#/$defs/librarySelectedPdf"},
        "fallback": {
          "type": "object",
          "properties": {
                  "used": {"const": false},
                  "reason": {"type": "null"}
                }
              },
        "searches": {
          "type": "array",
          "contains": {
                  "type": "object",
                  "properties": {
                    "target_kind": {"const": "source_pdf"},
                    "outcome": {"const": "found"}
                  },
                  "required": ["target_kind", "outcome"]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"resolution": {"const": "current_upload_fallback"}}},
          "then": {
            "properties": {
              "selected_pdf": {"$ref": "#/$defs/uploadSelectedPdf"},
        "fallback": {
          "type": "object",
          "properties": {
                  "used": {"const": true},
                  "reason": {"type": "string", "minLength": 1}
                }
              },
        "searches": {
          "type": "array",
          "contains": {
                  "type": "object",
                  "properties": {
                    "target_kind": {"const": "source_pdf"},
                    "outcome": {"const": "not_found"}
                  },
                  "required": ["target_kind", "outcome"]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"resolution": {"const": "unresolved"}}},
          "then": {
            "properties": {
              "selected_pdf": {"type": "null"},
        "fallback": {
          "type": "object",
          "properties": {
                  "used": {"const": false},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      ]
    },
    "study_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_type", "synthesis_mode", "included_reports", "total_participants", "quantitative_datasets", "follow_up", "not_applicable_reasons"],
      "properties": {
        "study_type": {"type": "string"},
        "synthesis_mode": {"type": "string"},
        "included_reports": {"type": "integer", "minimum": 0},
        "total_participants": {"type": ["integer", "null"], "minimum": 0},
        "quantitative_datasets": {"type": ["integer", "null"], "minimum": 0},
        "follow_up": {"type": ["string", "null"]},
        "not_applicable_reasons": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "card_storyboard_path": {
      "type": "string",
      "pattern": "^data/samples/S[0-9]{3}/card_storyboard\\.json$"
    },
    "artifact_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "filename", "sha256", "role"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
          "kind": {"enum": ["source_pdf", "canonical_render_queue", "alternate_render_queue", "rendered_cardset"]},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "kind", "description", "evidence_locations"],
        "properties": {
          "observation_id": {"type": "string", "pattern": "^O[0-9]{3}$"},
          "kind": {"enum": ["architecture", "claim_transform", "calibration", "provenance", "mechanism", "limitations", "decision_positioning", "evidence_grade", "quantitative_semantics", "companion_artifact", "voice_register"]},
          "description": {"type": "string", "minLength": 1},
          "evidence_locations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "contamination_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_id", "location", "issue", "preferred_handling"],
        "properties": {
          "note_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
          "location": {"type": "string"},
          "issue": {"type": "string"},
          "preferred_handling": {"type": "string"}
        }
      }
    },
    "analysis_date": {"type": "string", "format": "date"}
  },
  "$defs": {
    "librarySearchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "target_kind", "strategy", "query", "query_keys_used", "search_title_only", "outcome", "candidate_library_file_ids"],
      "properties": {
        "priority": {"type": "integer", "minimum": 1},
        "target_kind": {"enum": ["source_pdf", "supplement", "data"]},
        "strategy": {
          "enum": ["doi", "exact_title", "filename", "supplement", "data"],
          "description": "Primary-PDF lookup order is DOI, exact title, then filename; supplement/data lookup follows primary resolution when relevant. Sequence enforcement belongs to the repository validator."
        },
        "query": {"type": "string", "minLength": 1},
        "query_keys_used": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["title", "doi", "filename", "authors", "year"]}
        },
        "search_title_only": {"type": "boolean"},
        "outcome": {"enum": ["found", "not_found"]},
        "candidate_library_file_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "librarySelectedPdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "library_file_id", "file_id", "library_path", "filename", "version", "version_state", "sha256"],
      "properties": {
        "origin": {"const": "library"},
        "library_file_id": {"type": "string", "minLength": 1},
        "file_id": {"type": "string", "minLength": 1},
        "library_path": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "version": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "pattern": "^[0-9]+$"},
            {"type": "null"}
          ]
        },
        "version_state": {"enum": ["recorded", "not_exposed"]},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Must equal source.pdf_sha256; enforced by the repository validator because JSON Schema cannot compare sibling values."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"version_state": {"const": "recorded"}}},
          "then": {
            "properties": {
              "version": {
                "oneOf": [
                  {"type": "integer", "minimum": 0},
                  {"type": "string", "pattern": "^[0-9]+$"}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"version_state": {"const": "not_exposed"}}},
          "then": {"properties": {"version": {"type": "null"}}}
        }
      ]
    },
    "uploadSelectedPdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "upload_file_id", "workspace_path", "filename", "sha256"],
      "properties": {
        "origin": {"const": "current_upload"},
        "upload_file_id": {"type": "string", "minLength": 1},
        "workspace_path": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Must equal source.pdf_sha256; enforced by the repository validator because JSON Schema cannot compare sibling values."
        }
      }
    }
  }
}
