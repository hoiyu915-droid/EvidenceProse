{
  "contract_name": "EP_RENDERED_CARD_AUDIT",
  "contract_version": "1.0.0",
  "method_revision": "1.1-topology-gated",
  "status": "canonical",
  "scope": "Read-only post-render audit lane for EvidenceProse companion cards",
  "purpose": "Verify what the rendered card actually communicates against audited truth and bound literature, with mandatory visual-topology reconciliation before a card can pass.",
  "authority_model": {
    "scientific_truth_authority": "audited_truth_boundary",
    "source_surface_authority": "bound_primary_source",
    "editorial_intent_source": "final_card_json_or_queue_projection",
    "reader_experience_source": "rendered_image",
    "hard_rule": "Presence of the right words or concepts is never sufficient to pass a rendered card. Material visual relations must be reconstructed and reconciled edge by edge."
  },
  "integration": {
    "position": "after_render_before_release",
    "read_only": true,
    "tp03_write": false,
    "tp03_reseal": false,
    "image_edit_or_generation": false,
    "probe_mutation": false
  },
  "text_fidelity": {
    "mode": "semantic_equivalence",
    "verbatim_required": false,
    "wording_divergence_blocks": false,
    "must_preserve": [
      "claim identity",
      "negation",
      "direction",
      "material magnitude",
      "evidence strength",
      "causal ceiling",
      "uncertainty",
      "scope",
      "limitations",
      "attribution",
      "source layer",
      "source-defined list/category/order"
    ]
  },
  "mandatory_audit_sop": [
    {
      "stage": "RCA-00",
      "name": "ingest_bind_and_deduplicate",
      "must": [
        "bind image to card_id",
        "hash rendered image",
        "deduplicate identical images",
        "block ambiguous identity"
      ]
    },
    {
      "stage": "RCA-01",
      "name": "bind_primary_literature",
      "must": [
        "Library/primary-source binding when available",
        "record fallback honestly",
        "inspect source figure/table directly when a rendered relation derives from it"
      ]
    },
    {
      "stage": "RCA-02",
      "name": "build_expected_semantic_and_structure_packet",
      "must": [
        "central claims",
        "evidence strength and causal ceiling",
        "limitations/applicability/forbidden takeaways",
        "protected terms/lists/categories/sequences",
        "expected visual graph including branch conditions and terminal states"
      ]
    },
    {
      "stage": "RCA-03",
      "name": "blind_render_readback",
      "visibility": [
        "rendered image only"
      ],
      "must": [
        "read text and numbers",
        "extract every material node",
        "extract every material edge with source/target/direction/type/condition",
        "extract branch points",
        "extract terminal/non-terminal behavior",
        "extract grouping/category/order/scale/colour semantics"
      ],
      "freeze_before_comparison": true
    },
    {
      "stage": "RCA-04",
      "name": "visual_topology_reconciliation",
      "must": [
        "bind frozen observed graph by digest",
        "disposition every observed material edge",
        "cover every expected material relation",
        "check source node",
        "check target node",
        "check direction",
        "check relation type",
        "check branch condition",
        "check branch parent",
        "check terminal-state continuation",
        "check path-level implication",
        "check text-versus-visual contradiction",
        "never pass by concept presence alone"
      ]
    },
    {
      "stage": "RCA-05",
      "name": "source_surface_and_content_reconciliation",
      "must": [
        "semantic-equivalence text check",
        "source-defined list/cardinality/category/order check",
        "attribution/evidence-role check",
        "numeric and citation traceability check"
      ]
    },
    {
      "stage": "RCA-06",
      "name": "derive_per_card_verdict",
      "rule": "Any material visual-topology mismatch is VISUAL_SEMANTICS=fail even when every visible sentence is correct."
    },
    {
      "stage": "RCA-07",
      "name": "cross_card_and_package_audit",
      "must": [
        "cross-card contradictions",
        "evidence-role drift",
        "taxonomy drift",
        "scope expansion",
        "package limitation coverage"
      ]
    },
    {
      "stage": "RCA-08",
      "name": "repair_and_human_display",
      "must": [
        "every FAIL_RENDER/FAIL_SPEC gets executable repair ticket",
        "repair smallest failed region",
        "substantial structural change gets supported replacement material",
        "project all failed-card repair instructions into exactly one writing block"
      ]
    }
  ],
  "visual_topology_gate": {
    "observed_graph_source": "frozen blind readback",
    "required_dimensions": [
      "edge source node",
      "edge target node",
      "direction",
      "relation type",
      "branch condition",
      "branch parent",
      "terminal-state behavior",
      "path implication",
      "text-visual consistency"
    ],
    "material_failure_statuses": [
      "wrong_source_node",
      "wrong_target_node",
      "wrong_direction",
      "wrong_condition",
      "wrong_relation_type",
      "unsupported_relation",
      "omitted_material",
      "distorted",
      "branch_fail",
      "terminal_fail",
      "text_visual_fail"
    ],
    "unverifiable_behavior": "BLOCK_UNVERIFIABLE",
    "concept_presence_shortcut_forbidden": true,
    "source_figure_rule": "When the expected relation is figure/table-derived, the figure/table itself and its caption/context must be inspected; body-text recall alone is insufficient."
  },
  "verdicts": {
    "PASS": "all substantive axes and mandatory topology reconciliation pass",
    "PASS_WITH_WARNINGS": "only non-material deviations remain",
    "FAIL_RENDER": "sound expected science/spec, but rendered image materially changes or invents meaning/topology/source structure/traceability",
    "FAIL_SPEC": "render faithfully reflects a materially wrong upstream spec/truth/source binding",
    "BLOCK_UNVERIFIABLE": "material source/identity/render relation cannot be checked without guessing"
  },
  "repair_policy": {
    "required_for": [
      "FAIL_RENDER",
      "FAIL_SPEC"
    ],
    "actions": [
      "REMOVE",
      "REPLACE",
      "RELABEL",
      "REWIRE",
      "RECOMPOSE"
    ],
    "human_repair_text_required_for_every_failure": true,
    "preferred_scope": "smallest_failed_region_first",
    "substantial_change": {
      "fraction_threshold": 0.1,
      "threshold_role": "provisional operational heuristic",
      "minimum_total_semantic_weight": 10,
      "structural_triggers_override_fraction": true,
      "structural_triggers": [
        "central_visual_graph_rewire",
        "entire_semantic_module",
        "central_claim",
        "material_limitation",
        "closed_set_membership",
        "ordered_process",
        "reader_facing_information_hole"
      ],
      "supported_replacement_required": true,
      "replacement_support_priority": [
        "audited truth/Probe content",
        "bound primary source",
        "semantic-preserving explainer paraphrase"
      ],
      "no_supported_material": "BLOCKED_NO_SUPPORTED_MATERIAL"
    }
  },
  "human_repair_display": {
    "surface": "writing_block",
    "one_block_per_run": true,
    "first_line_exact": "imgedit",
    "section_heading_exact": "[圖卡名稱]",
    "section_order": "card_audit order",
    "include_only": [
      "FAIL_RENDER",
      "FAIL_SPEC"
    ],
    "content_rule": "Modification wording only needs semantic correctness; it need not reproduce source or queue wording verbatim.",
    "ordinary_chat_rule": "Outside the writing block, report only verdict/count/card-id summary; do not duplicate the repair body.",
    "canonical_text_shape": "imgedit\\n[圖卡名稱]\\n修改內容\\n\\n[圖卡名稱n]\\n修改內容"
  },
  "methodological_risk": {
    "blind_input_isolation_is_not_model_error_independence": true,
    "same_family_or_unknown_material": true,
    "high_stakes_material_requires_secondary_review": true
  },
  "validator_scope": {
    "does": [
      "hash/identity closure",
      "visual graph digest binding",
      "all material edge dispositions",
      "all expected relation coverage",
      "branch/terminal/text-visual topology closure",
      "verdict-axis consistency",
      "repair-ticket closure",
      "writing-block projection closure",
      "substantial replacement closure",
      "cardset and methodological release aggregation"
    ],
    "does_not": [
      "decide scientific truth",
      "infer image semantics",
      "redo literature audit",
      "edit or generate images",
      "mutate TP03/Probe"
    ]
  },
  "regression_cases": {
    "C02_WRONG_BRANCH_SOURCE": "If a rendered card draws hyperactivation/deactivation from the security-increase node while source/text require persistent insecurity as their parent branch, the card must FAIL_RENDER even if all labels and explanatory sentences are individually correct. Structural regression is encoded in tests/test_rendered_card_audit.py; the validator does not pretend to infer image semantics from fixture pixels."
  },
  "canonical_documents": {
    "specification": "docs/rendered_card_audit.md",
    "result_schema": "schemas/runtime/rendered_card_audit.schema.json",
    "validator": "scripts/validate_rendered_card_audit.py",
    "fixture": "fixtures/valid_rendered_card_audit.json",
    "tests": "tests/test_rendered_card_audit.py",
    "repair_template": "templates/rendered_card_audit_repair_block.txt"
  }
}
